# Contraseña para acceder al dashboard (déjalo vacío en local si no quieres login)
HQ_PASSWORD=cambia-esta-clave-segura

# Secreto para firmar las cookies de sesión (genera una cadena larga aleatoria en producción)
HQ_SECRET_KEY=genera-una-clave-secreta-larga-aqui

# Repositorio de tu vault de Obsidian en GitHub
VAULT_REPO_URL=https://github.com/camilomurielph/myVault
GITHUB_TOKEN=ghp_tu_token_de_github_aqui

# Ruta local dentro del contenedor (en Docker/Coolify déjalo en /app/vault)
OBSIDIAN_VAULT_PATH=/app/vault

# Sincronización automática (git pull --rebase + commit + push) tras cada edición
AUTO_GIT_SYNC=true
GIT_USER_NAME=Obsidian HQ
GIT_USER_EMAIL=hq@obsidian.local
